{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNEXT",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "ES2022"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@core/*": ["./src/core/*"],
      "@phaser/*": ["./src/phaser/*"],
      "@ui/*": ["./src/ui/*"],
      "@data/*": ["./src/data/*"],
      "@localization/*": ["./src/localization/*"],
      "@balance/*": ["./src/balance/*"]
    }
  },
  "include": ["src", "tests"],
  "exclude": ["node_modules", "dist"]
}
